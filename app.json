{
  "expo": {
    "name": "PPEye",
    "slug": "PPEye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ppeye-logo.png",
    "scheme": "ppeye",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ppeye-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ppeye-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.tanjim.abubokor.PPEye"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ppeye-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/ppeye-logo.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PPEye to access your camera for PPE photo capture.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PPEye to access your location for site safety submissions."
        }
      ],
      "expo-localization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.175589809991-9mv0c5pia4j5sbvt41bj0ttjci7s2hqi"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
