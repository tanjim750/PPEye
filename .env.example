# PPEye Environment Configuration Example
# Copy this file to .env and configure for your local environment.
# NEVER commit production credentials or client secrets to version control.

# Supabase Client Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# Storage Mode: 'server' (Supabase Edge Function mediated - Recommended for Production) or 'direct' (Native Google Sign-In)
EXPO_PUBLIC_STORAGE_MODE=server

# Google Sign-In (Web Client ID for Native Google Sign-In on Android/iOS)
# NOTE: Mobile clients should ONLY receive the OAuth client ID. Never expose client secrets or refresh tokens in the mobile client bundle!
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
